{
  "name": "sedbank-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SedBank — digital lending platform API (Express + Mongoose + Socket.IO)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
