# ---------------------------------------------------------------------------
# SedBank API — environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database --------------------------------------------------------------
# Leave MONGO_URI empty to boot an in-process MongoDB (zero setup, not persisted).
# For anything real, use a free MongoDB Atlas M0 cluster:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sedbank?retryWrites=true&w=majority
MONGO_URI=
USE_MEMORY_DB=

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate one with: openssl rand -hex 32
JWT_SECRET=sedbank-dev-secret-change-me
JWT_EXPIRES_IN=12h

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
# Add your Vercel URL for deployment, e.g. https://sedbank.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=
MAX_UPLOAD_MB=5

# --- Mocked OTP / test hooks ----------------------------------------------
# EXPOSE_OTP returns the mocked OTP in API responses so the UI and the
# Playwright suite can complete OTP flows. Defaults to on outside production.
EXPOSE_OTP=true
OTP_TTL_MINUTES=10

# ENABLE_TEST_HOOKS unlocks /api/testing/* (loan back-dating, data reset) and
# the bureau `simulate` parameter. MUST be false in production.
ENABLE_TEST_HOOKS=true

# --- Background jobs -------------------------------------------------------
# How often overdue EMIs are re-aged. 0 disables the timer.
DELINQUENCY_SWEEP_MINUTES=15

# --- Email (optional; all mail is console-logged when disabled) ------------
# Works with a free Mailtrap sandbox inbox or a Gmail app password.
SMTP_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SedBank (Demo) <no-reply@sedbank.test>

# --- Seed accounts ---------------------------------------------------------
SEED_ADMIN_EMAIL=admin@sedbank.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@sedbank.test
SEED_CUSTOMER_PASSWORD=Customer@12345
SEED_STAFF_PASSWORD=Staff@12345
