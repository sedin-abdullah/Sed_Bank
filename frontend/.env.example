# SedBank frontend configuration.
# Copy to .env and adjust for your environment.

# Base URL of the SedBank API (no trailing slash).
# Local:      http://localhost:5000
# Deployed:   https://sedbank-api.onrender.com
VITE_API_URL=http://localhost:5000

# Socket.IO endpoint. Leave empty to reuse VITE_API_URL.
VITE_SOCKET_URL=

# Shows the one-click demo login buttons on the sign-in screen.
VITE_SHOW_DEMO_LOGINS=true
